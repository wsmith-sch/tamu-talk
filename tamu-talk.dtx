%    \begin{macrocode}
\ProcessKeyOptions [tamu-talk]
%</package>
%    \end{macrocode}
%
% \section{\pkg{tamu-talk-compat}: Class and version checks}
%
%    \begin{macrocode}
%<*compat>
%<@@=tamu_talk>
\ProvidesExplPackage
  {tamu-talk-compat}
  {2026-10-24}
  {0.1.0}
  {ltx-talk version guard for tamu-talk}
%    \end{macrocode}
%
% Stop with a clear error unless the class is \pkg{ltx-talk}, and recent
% enough.
%
%    \begin{macrocode}
\msg_new:nnnn {tamu-talk} {wrong-class}
  { The~'tamu-talk'~package~requires~the~'ltx-talk'~class. }
  {
    Load~the~class~first:~\iow_char:N\\documentclass{ltx-talk}.~
    For~Beamer~presentations,~try~the~'beamerthemetamu'~theme~instead.
  }

\IfClassLoadedTF {ltx-talk}
  { }
  { \msg_fatal:nn {tamu-talk} {wrong-class} }

\msg_new:nnnn {tamu-talk} {ltx-talk-too-old}
  { tamu-talk~requires~ltx-talk~2026-09-10~or~later. }
  {
    tamu-talk~was~developed~against~ltx-talk~2026-09-10~and~has~not~
    been~checked~against~older~releases.~Update~ltx-talk,~e.g.~with~
    'tlmgr~update~ltx-talk'.
  }

\IfClassAtLeastTF {ltx-talk} {2026-09-10}
  { }
  { \msg_error:nn {tamu-talk} {ltx-talk-too-old} }
%</compat>
%    \end{macrocode}
